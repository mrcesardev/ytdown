# Configurações do Supabase (obter no painel do Supabase -> Project Settings -> API)
SUPABASE_URL=https://sua-instancia.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_secret_key

# URL pública da sua VPS (onde a API está rodando, ex: https://api.seudominio.com ou http://IP_DA_VPS:8000)
BASE_URL=http://localhost:8000

# Chave secreta opcional para autorizar requisições do frontend
API_SECRET_KEY=sua_chave_secreta_super_segura

# Domínios permitidos no CORS (separados por vírgula, ou * para testes)
ALLOWED_ORIGINS=http://localhost:3000,https://seu-app.vercel.app

# URL interna do Redis (já configurada para o docker-compose)
REDIS_URL=redis://redis:6379/0
