# Supabase Config (Obtenha em Project Settings -> API no Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://sua-instancia.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_public_key

# URL da API do Backend rodando na VPS (ou localhost para desenvolvimento)
# Em produção: https://api.seudominio.com ou http://IP_DA_VPS:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Chave secreta opcional para autorizar requisições à VPS (deve ser a mesma do backend)
NEXT_PUBLIC_API_SECRET_KEY=sua_chave_secreta_super_segura

# Monetização & Doações (Fase 1)
NEXT_PUBLIC_PIX_KEY=suachavepix@exemplo.com
NEXT_PUBLIC_PIX_NAME="Seu Nome Completo"
# NEXT_PUBLIC_ADS_ENABLED=true
# NEXT_PUBLIC_ADSTERRA_BANNER_KEY=seu_banner_key_aqui

# Download com Recompensa (Rewarded Ads)
# NEXT_PUBLIC_REWARDED_ADS_ENABLED=true
# NEXT_PUBLIC_REWARDED_COUNTDOWN=6
# NEXT_PUBLIC_REWARDED_SCRIPT_URL=https://exemplo.monetag.com/tag.js
